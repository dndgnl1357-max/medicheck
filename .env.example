# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 공유/커밋 금지)

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 공공데이터포털 (심평원 병용금기) — https://www.data.go.kr
DATA_GO_KR_SERVICE_KEY=

# Supabase (로그인) — Dashboard > Project Settings > API
# 반드시 'anon public' 키를 넣는다. 'service_role' 키는 절대 넣지 말 것.
SUPABASE_URL=https://dgnpfmemanechwgmnedg.supabase.co
SUPABASE_ANON_KEY=

# 앱 설정
APP_ENV=development
DATA_DIR=data
